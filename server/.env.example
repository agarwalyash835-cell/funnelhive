PORT=4000
# Public URL of the app — used in emails (verify / reset links) and link previews
APP_URL=http://localhost:4000

# Signs login sessions. If empty, a random secret is generated once and stored in DATA_DIR/.jwt-secret
JWT_SECRET=

# Where the SQLite database, uploads and daily backups live (default: this folder)
DATA_DIR=

# Extra origins allowed to call the API from a browser (comma separated). Same-origin needs nothing.
CORS_ORIGINS=

# ---- Platform (SaaS) ----
# Your login email(s): these accounts get the Admin panel once their email is verified (comma separated)
ADMIN_EMAILS=
# App processes sharing the database (default: number of CPU cores, max 4). 1 = single process.
WEB_CONCURRENCY=
# Raw page-view events are kept this many days (reports go back 365)
EVENTS_KEEP_DAYS=400
# Subscriptions are paid to YOUR Razorpay account. Set the keys in Admin → Plan & settings, or here
# (these win over the admin panel). Webhook URL: https://<your app>/api/billing/webhook
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
# "Continue with Google" on sign-up/login: OAuth client ID (Web application) from Google Cloud Console → Credentials.
# Add your app's address under Authorised JavaScript origins. Can also be set in Admin → Plan & settings.
GOOGLE_CLIENT_ID=

# Analytics day boundaries, in minutes from UTC (330 = India Standard Time)
REPORT_TZ_OFFSET_MIN=330

# ---- Email ----
# Each seller can connect their own SMTP in Settings → Email sending. These server-wide settings are the
# fallback, and are also used for account emails (verify / reset password). Without any, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true          # true for port 465 (default: true only when the port is 465)
MAIL_FROM=FunnelHive <no-reply@yourdomain.in>
# Or Mailercloud (https://mailercloud.com, transactional API) instead of SMTP — also settable in Admin → Email sending:
MAILERCLOUD_API_KEY=
# Or Resend (https://resend.com):
RESEND_API_KEY=

# Encrypts sellers' SMTP passwords and WhatsApp tokens at rest (default: derived from JWT_SECRET —
# set this if you might rotate JWT_SECRET, or saved passwords/tokens become unreadable)
ENCRYPTION_KEY=

# ---- WhatsApp ----
# Each seller connects the WhatsApp Cloud API in Settings (Phone number ID + permanent token). Nothing needed here.

# ---- Custom domains ----
# Sellers CNAME their domain to this host name (defaults to the host of APP_URL)
CNAME_TARGET=
# For apex domains (yourbrand.in without www) sellers need an A record — the server's public IP
SERVER_IP=
# Extra host names that are the app itself, not seller domains (comma separated)
APP_HOSTS=

# AI for funnel generation, AI chat, page edits and marketing agents — kie.ai (one key, many models).
# Takes priority over ANTHROPIC_API_KEY. KIE_MODEL: deepseek-v4-1-flash (default, cheapest), or any model your
# kie.ai key is enabled for, e.g. claude-sonnet-5-5, claude-haiku-4-5, gpt-5-5, gemini-3-5-flash, kimi-k3
KIE_API_KEY=
KIE_MODEL=deepseek-v4-1-flash
# AI_TIMEOUT_MS=240000

# Or Claude directly from Anthropic
# Claude for AI funnel generation, chat editing and Hive AI
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: serve uploaded images through a CDN that pulls from this server (https only)
# CDN_URL=https://cdn.yourdomain.com

# ---- Monitoring ----
# Error reports to Sentry (free plan: sentry.io → create a "Node.js" project → Settings → Client Keys (DSN)).
# Server errors, crashes and unhandled rejections are sent with the stack, route and user id only — never request
# bodies, headers or cookies; emails, phone numbers and tokens in messages are masked.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# The browser app reports with this DSN too (shown in /api/site — a DSN is public by design). To keep browser
# reports in a separate Sentry project, create a "React" project and put its DSN here:
# SENTRY_DSN_PUBLIC=
# Internals in /api/health?detail=1 and Prometheus /metrics need: Authorization: Bearer <METRICS_TOKEN>
# METRICS_TOKEN=
# Better Stack heartbeats (also settable in Admin → Monitoring): the app pings every minute; backups after every run
# BETTERSTACK_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/…
# BETTERSTACK_BACKUP_HEARTBEAT_URL=https://uptime.betterstack.com/api/v1/heartbeat/…
# /api/health (and /api/health/disk) report not-ok when the data disk has less free than this
# DISK_MIN_FREE_GB=1
# DISK_MIN_FREE_PCT=5
