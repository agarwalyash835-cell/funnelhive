PORT=4000
# Public URL of the app — used in emails (verify / reset links) and link previews
APP_URL=http://localhost:4000

# Signs login sessions. If empty, a random secret is generated once and stored in DATA_DIR/.jwt-secret
JWT_SECRET=

# Where the SQLite database, uploads and daily backups live (default: this folder)
DATA_DIR=

# Extra origins allowed to call the API from a browser (comma separated). Same-origin needs nothing.
CORS_ORIGINS=

# Analytics day boundaries, in minutes from UTC (330 = India Standard Time)
REPORT_TZ_OFFSET_MIN=330

# ---- Email ----
# Each seller can connect their own SMTP in Settings → Email sending. These server-wide settings are the
# fallback, and are also used for account emails (verify / reset password). Without any, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_SECURE=true          # true for port 465 (default: true only when the port is 465)
MAIL_FROM=FunnelForge <no-reply@yourdomain.in>
# Or Resend (https://resend.com) instead of SMTP:
RESEND_API_KEY=

# Encrypts sellers' SMTP passwords and WhatsApp tokens at rest (default: derived from JWT_SECRET —
# set this if you might rotate JWT_SECRET, or saved passwords/tokens become unreadable)
ENCRYPTION_KEY=

# ---- WhatsApp ----
# Each seller connects the WhatsApp Cloud API in Settings (Phone number ID + permanent token). Nothing needed here.

# ---- Custom domains ----
# Sellers CNAME their domain to this host name (defaults to the host of APP_URL)
CNAME_TARGET=
# For apex domains (yourbrand.in without www) sellers need an A record — the server's public IP
SERVER_IP=
# Extra host names that are the app itself, not seller domains (comma separated)
APP_HOSTS=

# AI for funnel generation, AI chat, page edits and marketing agents — kie.ai (one key, many models).
# Takes priority over ANTHROPIC_API_KEY. KIE_MODEL: deepseek-v4-1-flash (default, cheapest), or any model your
# kie.ai key is enabled for, e.g. claude-sonnet-5-5, claude-haiku-4-5, gpt-5-5, gemini-3-5-flash, kimi-k3
KIE_API_KEY=
KIE_MODEL=deepseek-v4-1-flash
# AI_TIMEOUT_MS=240000

# Or Claude directly from Anthropic
Claude for AI funnel generation, chat editing and marketing agents
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: serve uploaded images through a CDN that pulls from this server (https only)
# CDN_URL=https://cdn.yourdomain.com
