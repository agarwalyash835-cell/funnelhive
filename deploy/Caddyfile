# Caddy in front of FunnelHive: HTTPS for the app AND for every seller's custom domain.
# Certificates for custom domains are issued on demand — but only after FunnelHive confirms
# the domain is connected and verified (the "ask" endpoint), so nobody can make you request
# certificates for random domains.
#
# 1. Point your app domain (APP_DOMAIN below, e.g. app.yourbrand.in) at this server.
# 2. Set APP_URL=https://app.yourbrand.in for FunnelHive.
# 3. Sellers CNAME their domains to app.yourbrand.in (or an A record to SERVER_IP).

{
	email {$ACME_EMAIL:admin@example.com}
	on_demand_tls {
		ask http://funnelhive:4000/api/domains/tls-check
	}
}

# The app itself
{$APP_DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy funnelhive:4000 {
		# while the app container is swapped during a deploy (a few seconds), keep retrying instead of a 502
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

# Live funnel pages on their own domain (PAGES_DOMAIN, e.g. pages.yourbrand.in; matches PAGES_URL for the app),
# so buyers' pages never share an origin with the dashboard. Unset, it only answers pages.localhost.
{$PAGES_DOMAIN:pages.localhost} {
	encode zstd gzip
	reverse_proxy funnelhive:4000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

# The previous app and pages addresses (after moving to a new domain). Browsers are sent to the new address;
# API calls (payment webhooks, open pages, saved links) are still answered here, since webhooks don't follow redirects.
{$OLD_APP_DOMAIN:old-app.localhost} {
	encode zstd gzip
	@browser {
		method GET HEAD
		not path /api/* /t/* /mcp*
	}
	redir @browser https://{$APP_DOMAIN}{uri} permanent
	reverse_proxy funnelhive:4000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
{$OLD_PAGES_DOMAIN:old-pages.localhost} {
	encode zstd gzip
	@browser {
		method GET HEAD
		not path /api/* /t/*
	}
	redir @browser https://{$PAGES_DOMAIN}{uri} permanent
	reverse_proxy funnelhive:4000 {
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}

# Any other host name: sellers' custom domains (certificate issued on first visit)
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy funnelhive:4000 {
		# while the app container is swapped during a deploy (a few seconds), keep retrying instead of a 502
		lb_try_duration 30s
		lb_try_interval 500ms
	}
}
